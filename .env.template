# Betfair credentials
BETFAIR_USERNAME=your_email@example.com
BETFAIR_PASSWORD=your_password
BETFAIR_APP_KEY=your_app_key
# Optional: override the SSO login URL (use .com.au for AU accounts if needed)
# BETFAIR_SSO_URL=https://identitysso.betfair.com.au/api/login
# Optional: adjust login retries for flaky networks
# BETFAIR_SSO_RETRIES=5
# BETFAIR_SSO_RETRY_WAIT=3

# Optional: certificate login (only needed later for headless automation)
# On Betfair AU this can be gated/hidden for new accounts. You can leave these blank.
# Use absolute paths to the files if you do have them.
# Optional: set BETFAIR_CERT_PATH to a directory containing client-2048.crt and client-2048.key.
# BETFAIR_CERT_PATH=/absolute/path/to/certs
BETFAIR_CERT_FILE=/absolute/path/to/client-2048.crt
BETFAIR_KEY_FILE=/absolute/path/to/client-2048.key

# Paths
DATA_PATH=data/db.duckdb
ARTIFACTS_DIR=artifacts
